rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: User is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: User has specific role
    function hasRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'guest') == role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'guest') == 'superAdmin';
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'guest') == 'admin';
    }

    function isOwner() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'guest') == 'owner';
    }

    function ownsVenue(venueId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
    }

    function isAssignedToVenue(venueId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('venueId', '') == venueId ||
        get(/databases/$(database)/documents/venues/$(venueId)).data.get('assignedAdminId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/venues/$(venueId)).data.get('assignedManagerId', '') == request.auth.uid
      );
    }

    // 1. Users Collection (Protected against role privilege escalation)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.get('role', 'guest') in ['guest', 'owner', 'staff']) ||
        isSuperAdmin() || isAdmin() || isOwner()
      );
      allow update: if isSuperAdmin() || isAdmin() || isOwner() || (
        isAuthenticated() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
         request.resource.data.role == resource.data.role)
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Venues Collection
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAuthenticated() && (
        // For existing docs: check ownership OR assignment
        (resource != null && (
          resource.data.ownerId == request.auth.uid ||
          isAssignedToVenue(venueId)
        )) ||
        // For new docs: allow create if authenticated (onboarding flow)
        (resource == null)
      ));
    }

    // 3. Visits Collection
    match /visits/{visitId} {
      allow create, read, update, delete: if isAuthenticated();
    }

    // 4. Leads Collection (B2B and B2C tracking)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /b2b_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /leads_b2b_audit/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // 4.5 Complaints Collection (NPS < 4 stars feedback)
    match /complaints/{complaintId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // 5. Venue Requests Collection
    match /venue_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read, delete: if isAuthenticated();
    }

    // 6. Deposit Tiers Collection
    match /deposit_tiers/{tierId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 7. Deposit Transactions Collection
    match /deposit_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create, write: if isAuthenticated();
    }

    // 8. POS Sessions Collection (State Machine)
    match /pos_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || ownsVenue(resource.data.venueId) || isAssignedToVenue(resource.data.venueId);
    }

    // 9. Notifications Collection
    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // 10. Staff Requests Collection (Staff registration and role assignment)
    match /staff_requests/{requestId} {
      allow create, read, update, delete: if true;
    }

    // 11. Scheduled Vouchers Collection
    match /scheduled_vouchers/{voucherId} {
      allow read, write, create, update, delete: if isAuthenticated();
    }

    // 13. Orders Collection (Revoo Direct Delivery)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAuthenticated();
      allow delete: if isSuperAdmin() || isOwner();
    }

    // 14. Scrape Jobs Subcollection
    match /venues/{venueId}/scrape_jobs/{jobId} {
      allow read, write, create, update: if true;
    }

    // 15. Bookings Collection (Revoo Services)
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update: if isAuthenticated();
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource != null && ownsVenue(resource.data.venueId));
    }

    // 16. Services Subcollections & AI Knowledge Base
    match /venues/{venueId}/services/{serviceId} {
      allow read: if true;
      allow write: if isSuperAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/staff/{staffId} {
      allow read: if true;
      allow write: if isSuperAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/yield_rules/{ruleId} {
      allow read: if true;
      allow write: if isSuperAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/ai_knowledge/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/change_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // 17. Fleet Templates & Scheduled Trips (Dynamic Capacity & Seating SoT)
    match /venues/{venueId}/fleetTemplates/{templateId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/scheduled_trips/{tripId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
      allow update: if true;
    }

    match /venues/{venueId}/trips/{tripId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
      allow update: if true;
    }

    // 18. Continuous Knowledge Docs, Sources & Manager Inquiries (Omnichannel AI SoT)
    match /venues/{venueId}/knowledge_docs/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/knowledge_sources/{sourceId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/manager_inquiries/{inquiryId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 19. Venue Subcollections: Redemptions, Clicks, Tiers & Root Scans Log
    match /venues/{venueId}/redemptions/{redemptionId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /venues/{venueId}/clicks/{clickId} {
      allow create: if true;
      allow read: if isAuthenticated();
    }

    match /venues/{venueId}/tiers/{tierId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin() || ownsVenue(venueId) || isAssignedToVenue(venueId);
    }

    match /scans_log/{scanId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
  }
}
